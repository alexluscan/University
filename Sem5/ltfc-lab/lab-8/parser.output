state 0

    0 $accept: . program $end

    LOAD     shift, and go to state 1
    SAVE     shift, and go to state 2
    REPLACE  shift, and go to state 3
    PRINT    shift, and go to state 4
    DELETE   shift, and go to state 5
    COUNT    shift, and go to state 6
    APPEND   shift, and go to state 7
    IF       shift, and go to state 8
    ID       shift, and go to state 9

    $default  reduce using rule 3 (stmt_list)

    program       go to state 10
    stmt_list     go to state 11
    stmt          go to state 12
    load_stmt     go to state 13
    save_stmt     go to state 14
    replace_stmt  go to state 15
    print_stmt    go to state 16
    delete_stmt   go to state 17
    count_stmt    go to state 18
    append_stmt   go to state 19
    if_stmt       go to state 20
    expr_stmt     go to state 21


state 1

   13 load_stmt: LOAD . STRING opt_into_id

    STRING  shift, and go to state 22


state 2

   14 save_stmt: SAVE . STRING opt_into_id

    STRING  shift, and go to state 23


state 3

   17 replace_stmt: REPLACE . STRING TO STRING

    STRING  shift, and go to state 24


state 4

   18 print_stmt: PRINT . STRING
   19           | PRINT . ID

    STRING  shift, and go to state 25
    ID      shift, and go to state 26


state 5

   20 delete_stmt: DELETE . FROM ID opt_where

    FROM  shift, and go to state 27


state 6

   21 count_stmt: COUNT . FROM ID opt_where

    FROM  shift, and go to state 28


state 7

   22 append_stmt: APPEND . STRING INTO ID

    STRING  shift, and go to state 29


state 8

   25 if_stmt: IF . cond THEN stmt_list ENDIF

    ID  shift, and go to state 30

    cond  go to state 31


state 9

   26 expr_stmt: ID . ASSIGN expr

    ASSIGN  shift, and go to state 32


state 10

    0 $accept: program . $end

    $end  shift, and go to state 33


